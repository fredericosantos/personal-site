---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { getCollection } from "astro:content";

const publications = (await getCollection("publications")).sort((a, b) => b.data.year - a.data.year);
---

<Layout title="CV · Frederico Santos">
  <nav class="fixed top-0 left-0 right-0 z-50 bg-bg/80 backdrop-blur-md border-b border-border">
    <div class="max-w-4xl mx-auto px-6 h-12 flex items-center justify-between">
      <a href="/" aria-label="Home" class="text-accent hover:text-text transition-colors inline-flex items-center"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></a>
      <div class="flex items-center gap-3 text-xs">
        <a href="/frederico-santos-cv.pdf" target="_blank" rel="noopener" class="px-3 py-1 rounded border border-accent text-accent hover:bg-accent hover:text-bg transition-all">
          Download PDF ↓
        </a>
        <a href="/" class="text-text-muted hover:text-accent transition-colors">← back</a>
      </div>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto px-6 pt-24 pb-16">
    <SectionHeader title="CV" />

    <!-- Summary -->
    <section class="mt-8 pl-6 border-l border-border text-text-muted leading-relaxed">
      <p>
        <span class="text-text">Frederico J.J.B. Santos</span> — PhD candidate at the University of Trieste, using methods from evolutionary computation to design a GPU-native PyTorch framework for neuroevolution. Five peer-reviewed publications, including a Q1 journal article in <em>Applied Soft Computing</em> and papers at CORE A conferences (GECCO, EuroGP, EvoApplications).
      </p>
      <p class="text-text-dim text-xs mt-3 font-mono">
        Trieste, Italy · <a class="underline underline-offset-2 hover:text-accent" href="mailto:fredericojose.jacomedebritosantos@phd.units.it">fredericojose.jacomedebritosantos@phd.units.it</a> · ORCID <a class="underline underline-offset-2 hover:text-accent" href="https://orcid.org/0000-0003-3589-7877" target="_blank" rel="noopener">0000-0003-3589-7877</a>
      </p>
    </section>

    <div class="pl-6 border-l border-border space-y-8 mt-10">

      <!-- Education -->
      <section>
        <p class="text-accent-secondary text-xs uppercase tracking-widest mb-3">Education</p>
        <div class="font-mono text-sm space-y-4">
          <div>
            <div class="flex gap-3">
              <span class="text-border">├──</span>
              <div>
                <span class="text-accent-secondary">2024─now</span>
                <span class="text-text ml-2 font-sans font-medium">PhD in Artificial Intelligence</span>
              </div>
            </div>
            <div class="ml-8 text-text-muted text-sm font-sans">
              <p>University of Trieste, Italy</p>
              <p class="text-text-dim text-xs mt-0.5">GPU-native PyTorch framework for neuroevolution · GP-evolved PSO velocity rules</p>
            </div>
          </div>

          <div>
            <div class="flex gap-3">
              <span class="text-border">├──</span>
              <div>
                <span class="text-accent-secondary">2020─2023</span>
                <span class="text-text ml-2 font-sans font-medium">MSc in Data Science &amp; Advanced Analytics</span>
              </div>
            </div>
            <div class="ml-8 text-text-muted text-sm font-sans">
              <p>NOVA Information Management School, Portugal</p>
              <p class="text-text-dim text-xs mt-0.5">GPA 18/20 · thesis adapted for publication in <em>Applied Soft Computing</em></p>
            </div>
          </div>

          <div>
            <div class="flex gap-3">
              <span class="text-border">└──</span>
              <div>
                <span class="text-accent-secondary">earlier</span>
                <span class="text-text ml-2 font-sans font-medium">BSc in Management &amp; Business Administration</span>
              </div>
            </div>
            <div class="ml-8 text-text-muted text-sm font-sans">
              <p>Católica Lisbon School of Business &amp; Economics, Portugal</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Experience -->
      <section>
        <p class="text-accent-secondary text-xs uppercase tracking-widest mb-3">Experience</p>
        <div class="font-mono text-sm space-y-4">
          <div>
            <div class="flex gap-3">
              <span class="text-border">├──</span>
              <div>
                <span class="text-accent-secondary">2025─now</span>
                <span class="text-text ml-2 font-sans font-medium">Research &amp; Data Mining</span>
              </div>
            </div>
            <div class="ml-8 text-text-muted text-sm font-sans">
              <p>RADAR-AIM, Erasmus+ Cooperation Partnership</p>
              <p class="text-text-dim text-xs mt-0.5">Lead WP2 of an EU programme on AI for sustainability — scraped &amp; curated a 300+ course dataset, designed an AI-integration taxonomy, ran keyword-based classification.</p>
            </div>
          </div>

          <div>
            <div class="flex gap-3">
              <span class="text-border">├──</span>
              <div>
                <span class="text-accent-secondary">2023─2024</span>
                <span class="text-text ml-2 font-sans font-medium">Data Science Research Intern</span>
              </div>
            </div>
            <div class="ml-8 text-text-muted text-sm font-sans">
              <p>CrowdSec</p>
              <p class="text-text-dim text-xs mt-0.5">Built a PyTorch research framework for real-time malicious-HTTP detection; benchmarked fastText, RoBERTa and Random Forest classifiers; shipped a CLI for training, evaluation and ONNX export.</p>
            </div>
          </div>

          <div>
            <div class="flex gap-3">
              <span class="text-border">└──</span>
              <div>
                <span class="text-accent-secondary">2023</span>
                <span class="text-text ml-2 font-sans font-medium">Machine Learning Consultant</span>
              </div>
            </div>
            <div class="ml-8 text-text-muted text-sm font-sans">
              <p>A400 — Structural Engineering</p>
              <p class="text-text-dim text-xs mt-0.5">Designed an algorithm that automated 90% of rebar layout placement, cutting per-region engineer time from ~20 minutes to under one.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Publications -->
      <section>
        <p class="text-accent-secondary text-xs uppercase tracking-widest mb-3">Publications</p>
        <ol class="space-y-3 list-none">
          {publications.map((pub) => (
            <li class="font-mono text-sm">
              <a href={pub.data.url} target="_blank" rel="noopener" class="block border border-border rounded p-3 bg-surface/40 hover:bg-surface/80 hover:border-accent/30 transition-all">
                <span class="text-text font-medium font-sans">{pub.data.title}</span>
                <span class="block text-text-muted text-xs mt-1 font-sans">{pub.data.authors}</span>
                <span class="block text-accent-secondary text-xs mt-1">{pub.data.venue} · {pub.data.year}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <!-- Awards & Service -->
      <section>
        <p class="text-accent-secondary text-xs uppercase tracking-widest mb-3">Awards &amp; Service</p>
        <ul class="font-mono text-sm text-text-muted space-y-2">
          <li><span class="text-border">├──</span> EvoApplications 2026 — <span class="text-accent-secondary">Best Poster Runner-Up</span> (co-author)</li>
          <li><span class="text-border">├──</span> SPECIES Summer School on Evolutionary Computation, Moraira, Spain · 2025</li>
          <li><span class="text-border">└──</span> Conference Volunteer · EvoStar 2025 &amp; Ital-IA 2025, Trieste</li>
        </ul>
      </section>

      <!-- Languages -->
      <section>
        <p class="text-accent-secondary text-xs uppercase tracking-widest mb-3">Languages</p>
        <ul class="font-mono text-sm text-text-muted space-y-1">
          <li><span class="text-border">├──</span> <span class="text-text">Portuguese</span> — native</li>
          <li><span class="text-border">├──</span> <span class="text-text">English</span> — fluent</li>
          <li><span class="text-border">└──</span> <span class="text-text">Italian</span> — A1</li>
        </ul>
      </section>

    </div>
  </main>
</Layout>
