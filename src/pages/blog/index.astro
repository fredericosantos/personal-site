---
import Layout from "../../layouts/Layout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog · Frederico Santos">
  <nav class="fixed top-0 left-0 right-0 z-50 bg-bg/80 backdrop-blur-md border-b border-border">
    <div class="max-w-4xl mx-auto px-6 h-12 flex items-center justify-between">
      <a href="/" class="text-accent text-sm font-bold tracking-tight">
        frederico<span class="text-text-dim">@</span>fsx.app
      </a>
      <a href="/" class="text-text-muted hover:text-accent text-xs transition-colors">
        ← back
      </a>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto px-6 pt-24 pb-16">
    <SectionHeader title="Blog" />

    <div class="space-y-3">
      {posts.map((post, i) => (
        <a
          href={`/blog/${post.id}`}
          class="group block border border-border rounded-lg p-5 bg-surface/40 hover:bg-surface/80 hover:border-accent/30 transition-all"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-text font-sans font-medium group-hover:text-accent transition-colors">
                <span class="text-border text-xs mr-2">{i === posts.length - 1 ? "└──" : "├──"}</span>
                {post.data.title}
              </p>
              <p class="text-text-muted text-sm mt-1 ml-8">{post.data.description}</p>
              {post.data.tags && (
                <div class="flex gap-2 mt-2 ml-8">
                  {post.data.tags.map((tag) => (
                    <span class="text-xs text-text-dim">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <time
              class="text-text-dim text-xs shrink-0 tabular-nums"
              datetime={post.data.date.toISOString()}
            >
              {post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
