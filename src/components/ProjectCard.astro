---
interface Props {
  slug: string;
  title: string;
  description: string;
  language: string;
  tags: string[];
  private?: boolean;
}
const { slug, title, description, language, tags, private: isPrivate } = Astro.props;
---
<a
  href={`/projects/${slug}`}
  class="group block border border-border rounded-lg p-4 bg-surface/40 hover:bg-surface/80 hover:border-accent/30 transition-all"
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <span class="text-accent font-semibold group-hover:text-text transition-colors">
        {title}/
      </span>
      {isPrivate && (
        <span class="ml-2 text-[10px] uppercase tracking-widest text-text-dim border border-border rounded px-1.5 py-0.5 align-middle">private</span>
      )}
      <p class="text-text-muted text-sm mt-1">{description}</p>
      <div class="flex items-center gap-2 mt-2 flex-wrap">
        <span class="text-xs px-1.5 py-0.5 rounded bg-surface-2 text-accent-secondary">
          {language}
        </span>
        {tags.map((tag) => (
          <span class="text-xs text-text-dim">#{tag}</span>
        ))}
      </div>
    </div>
    <span class="text-text-dim group-hover:text-accent transition-colors text-sm shrink-0">
      →
    </span>
  </div>
</a>
