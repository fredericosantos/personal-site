---
interface Skill {
  data: { title: string; category: string; comment?: string };
}
interface Props {
  skills: Skill[];
}
const { skills } = Astro.props;

const grouped = skills.reduce((acc, s) => {
  const cat = s.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(s);
  return acc;
}, {} as Record<string, Skill[]>);
const categories = Object.entries(grouped);
---
<div class="font-mono text-sm">
  {categories.map(([category, categorySkills], catIndex) => {
    const isLastCat = catIndex === categories.length - 1;
    const catPrefix = isLastCat ? "└── " : "├── ";
    return (
      <div>
        <div class="flex">
          <span class="text-border whitespace-pre">{catPrefix}</span>
          <span class="text-accent-secondary">{category}/</span>
        </div>
        <div class={`ml-4 ${isLastCat ? "pl-4" : "pl-4 border-l border-border"}`}>
          {categorySkills.map((skill, i) => {
            const isLast = i === categorySkills.length - 1;
            const prefix = isLast ? "└── " : "├── ";
            const fileName = skill.data.title.toLowerCase().replace(/\s+/g, "-") + ".md";
            return (
              <div class="flex">
                <span class="text-border whitespace-pre">{prefix}</span>
                <span class="text-text">{fileName}</span>
                {skill.data.comment && (
                  <span class="text-text-dim ml-3"># {skill.data.comment}</span>
                )}
              </div>
            );
          })}
        </div>
      </div>
    );
  })}
</div>
