<div class="flex items-center justify-center gap-6 flex-wrap">
  {links.map((link) => (
    <a
      href={link.url}
      target={link.url.startsWith("http") ? "_blank" : undefined}
      rel={link.url.startsWith("http") ? "noopener" : undefined}
      class="group font-mono text-[14px] leading-none tracking-[-0.02em] uppercase text-[#ccc9c7] flex items-center gap-2 hover:text-text transition-colors"
    >
      <span class="glitch-icon" set:html={link.icon} />
      <span>{link.label}</span>
    </a>
  ))}
</div>
