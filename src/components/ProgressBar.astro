---
interface Props {
  /** Value between 0 and 1 (e.g., 0.46 = 46%) */
  value: number;
  /** Total number of bar segments */
  segments?: number;
  /** Optional label shown after the bar */
  label?: string;
  /** Show percentage after the bar */
  showPercent?: boolean;
}

const { value, segments = 10, label, showPercent = false } = Astro.props;

const clamped = Math.min(Math.max(value, 0), 1);
const filled = Math.round(clamped * segments);
const empty = segments - filled;
const pct = (clamped * 100).toFixed(1);
---
<span class="font-mono text-xs inline-flex items-center gap-2">
  <span>
    <span class="text-accent">{"█".repeat(filled)}</span><span class="text-text-dim">{"░".repeat(empty)}</span>
  </span>
  {showPercent && <span class="text-accent font-bold">{pct}%</span>}
  {label && <span class="text-text-dim">{label}</span>}
</span>
